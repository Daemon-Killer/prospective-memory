<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Row (Time and Priority) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_timeline_item_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TIME"
            android:textColor="#80CBC4"
            android:textSize="10sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_timeline_item_priority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1F1F1F"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="PRIORITY"
            android:textColor="#FFB74D"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_timeline_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Reminder Title"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_timeline_item_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Notes"
        android:textColor="#777777"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_timeline_item_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/widget_timeline_item_btn_snooze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="SNOOZE"
            android:textColor="#AAAAAA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/widget_timeline_item_btn_complete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#10B981"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="DONE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
